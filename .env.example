# SUNO API Configuration
SUNO_API_KEY=your_suno_api_key_here
SUNO_API_BASE_URL=https://api.suno.ai

# Runway ML API (for video generation)
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_API_BASE_URL=https://api.runwayml.com

# Stability AI API (alternative video generation)
STABILITY_API_KEY=your_stability_api_key_here

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_change_in_production
DEBUG=True

# Database
DATABASE_URL=sqlite:///kpgm.db

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=2147483648

# Processing Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
TEMP_FOLDER=/tmp/kpgm

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=True

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=86400

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
